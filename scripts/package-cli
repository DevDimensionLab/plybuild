#!/usr/bin/env python3
"""Maintainer build: create an immutable macOS arm64 consumer package from clean HEAD."""
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile


def main():
    if len(sys.argv) != 3 or not re.fullmatch(r"v\d+\.\d+\.\d+[A-Za-z0-9.+-]*", sys.argv[1]):
        raise SystemExit("Usage: scripts/package-cli <version> <new-output-directory>")
    version = sys.argv[1]
    repo = Path(__file__).resolve().parent.parent
    output = Path(sys.argv[2]).absolute()
    if output.exists() or output.is_relative_to(repo):
        raise SystemExit("Package output must be absent and outside the source checkout")
    def git(*args):
        return subprocess.check_output(["git", *args], cwd=repo, text=True).strip()
    commit = git("rev-parse", "HEAD")
    if git("status", "--porcelain"):
        raise SystemExit("Release requires a clean committed source checkout")
    output.parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix=".ply-package-", dir=output.parent))
    try:
        package = stage / ("ply-" + version + "-darwin-arm64")
        package.mkdir()
        env = dict(os.environ, CGO_ENABLED="0", GOOS="darwin", GOARCH="arm64", GOWORK="off", GOENV="off")
        module = "github.com/devdimensionlab/plybuild/internal/buildinfo"
        for binary in ("ply", "ply-install"):
            subprocess.run(["go", "build", "-mod=readonly", "-trimpath", "-buildvcs=true", "-ldflags", f"-s -w -X {module}.Version={version} -X {module}.SourceCommit={commit}", "-o", str(package / binary), "./cmd/" + binary], cwd=repo, env=env, check=True)
        digest = lambda p: "sha256:" + hashlib.sha256(p.read_bytes()).hexdigest()
        manifest = dict(kind="PlyRelease@1", schema_version=1, version=version, source_commit=commit, os="darwin", arch="arm64", sha256=digest(package / "ply"), size_bytes=(package / "ply").stat().st_size, registry_formats=[1, 2, 3, 4, 5, 6, 7, 8, 9], installer_sha256=digest(package / "ply-install"))
        (package / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
        pin = digest(package / "manifest.json")
        (stage / "manifest.sha256").write_text(pin + "\n")
        shutil.copyfile(repo / "docs/cli-installation.md", package / "INSTALL.md")
        archive = stage / (package.name + ".tar.gz")
        with tarfile.open(archive, "w:gz") as tar:
            tar.add(package, arcname=package.name)
        (stage / "archive.sha256").write_text(digest(archive) + "\n")
        if git("rev-parse", "HEAD") != commit or git("status", "--porcelain"):
            raise SystemExit("Source changed during packaging; release not published")
        stage.rename(output)
        print(json.dumps(dict(directory=str(output), package=str(output / package.name), manifest_sha256=pin, **manifest)))
    finally:
        if stage.exists():
            shutil.rmtree(stage)


if __name__ == "__main__":
    main()
