#!/usr/bin/env bash
# P4 seam-test driver only. This file is deliberately non-executable and does
# not implement the later interactive-build mutation harness.
# 8. interactive server binds only to loopback

set -euo pipefail
export LC_ALL=C LANG=C GOENV=off GOWORK=off

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
go_bin=${GO:-go}

cd "$repo_root"
"$go_bin" test -json ./cmd ./internal/adapter/server ./pkg/webservice ./pkg/webservice/api -count=1 \
	-run '^(TestInteractiveBuildPreservesRootOptionsEndpointCallbackAndValidationOrder|TestInteractiveUpgradePreservesProjectGuardsEndpointAndCallbackCaller|TestInteractiveWebserviceCallersPreserveEndpointServerBrowserAndCallbackComposition|TestInteractiveWebServerBindsOnlyToExactIPv4Loopback|TestStartWebServerSelectsExactProductionDependenciesAndPublicComposition|TestStartWebServerRegistersExactHandlersBeforeOneListenAndLogsOnlyNonNilError|TestStopWebServerSelectsExactProductionDependenciesAndPublicComposition|TestStopWebServerUsesExactBackgroundFiveSecondContextOnceDefersCancelAndIgnoresError|TestRecordedWebServerDependenciesRejectEmptyPopulations|TestOpenBrowserSelectsExactSystemRunnerWithoutProcessStandardOutputAndRuntimePlatform|TestBrowserLauncherPreservesEveryPlatformRequestURLStartAttemptAndError|TestDependenciesDefaultToSafeNoServerOperation|TestListenAndServePassesExactServerOnceAndReturnsExactError|TestShutdownPassesExactServerAndContextOnceAndReturnsExactError|TestSystemSelectsOneCompleteDirectServerOperationDependency|TestRecordedServerOperationsRejectEmptyPopulations|TestGetGenerateRendersExactStatusAndBodyBytesAndRestoresGlobals|TestGetUpgradeRendersExactStatusAndBodyBytesAndRestoresGlobals|TestPostGeneratePreservesFormMutationCallbackAndExactResponseAndRestoresGlobals|TestPostUpgradeDeliversOneCallbackAndExactResponseAndRestoresGlobals|TestRecordedWebserviceAPICallbacksRejectEmptyPopulation)$'
