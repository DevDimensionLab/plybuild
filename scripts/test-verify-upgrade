#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C LANG=C
unset CDPATH

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmp_base=${TMPDIR:-/tmp}
tmp_base=${tmp_base%/}
work_root=$(mktemp -d "$tmp_base/ply-test-verify-upgrade.XXXXXX")
cleanup_temp_root() {
	find "$work_root" -type d -exec chmod u+rwx {} + 2>/dev/null || true
	rm -rf -- "$work_root"
}
trap cleanup_temp_root EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
source "$repo_root/test/acceptance/meta-common.sh"
artifact="$work_root/fake-ply"

cat >"$artifact" <<'FAKE_ARTIFACT'
#!/usr/bin/env bash
set -euo pipefail
mode=${PLY_FAKE_MODE:-good}
if [[ "${1:-}" == upgrade && "${2:-}" == --help ]]; then
	[[ "$mode" != bad-help ]] || exit 1
	printf 'Perform upgrade on existing projects\n'
	exit 0
fi
target=''
has_group=false
previous=''
for argument in "$@"; do
	if [[ "$previous" == --target ]]; then target=$argument; fi
	[[ "$argument" != --groupId ]] || has_group=true
	previous=$argument
done
if [[ "$has_group" != true ]]; then
	[[ "$mode" != bad-input-write ]] || printf 'unexpected\n' >"$target/created"
	[[ "$mode" != bad-input-success ]] || exit 0
	exit 1
fi
if [[ "$mode" != noop ]]; then
	sed 's/<gson.version>2.10.1<\//<gson.version>2.10.2<\//' \
		"$target/pom.xml" >"$target/pom.xml.next"
	mv "$target/pom.xml.next" "$target/pom.xml"
fi
if [[ "$mode" == broad-write ]]; then
	printf '\nmeta-mutation\n' >>"$target/app-meta.xml"
fi
if [[ "$mode" != wrong-output ]]; then
	printf 'outdated dependency com.google.code.gson:gson [2.10.1 vs 2.10.2]\n'
fi
exit 0
FAKE_ARTIFACT
chmod +x "$artifact"

verifier="$repo_root/scripts/verify-upgrade"
acceptance_meta_expect_pass good env PLY_VERIFY_ARTIFACT="$artifact" PLY_FAKE_MODE=good "$verifier"
acceptance_meta_expect_fail noop env PLY_VERIFY_ARTIFACT="$artifact" PLY_FAKE_MODE=noop "$verifier"
acceptance_meta_expect_fail broad-write env PLY_VERIFY_ARTIFACT="$artifact" PLY_FAKE_MODE=broad-write "$verifier"
acceptance_meta_expect_fail wrong-output env PLY_VERIFY_ARTIFACT="$artifact" PLY_FAKE_MODE=wrong-output "$verifier"
acceptance_meta_expect_fail bad-help env PLY_VERIFY_ARTIFACT="$artifact" PLY_FAKE_MODE=bad-help "$verifier"
acceptance_meta_expect_fail bad-input-success env PLY_VERIFY_ARTIFACT="$artifact" PLY_FAKE_MODE=bad-input-success "$verifier"
acceptance_meta_expect_fail bad-input-write env PLY_VERIFY_ARTIFACT="$artifact" PLY_FAKE_MODE=bad-input-write "$verifier"
printf 'test-verify-upgrade: PASS (%s controls)\n' "$acceptance_meta_control"
