#!/usr/bin/env bash
# P3 seam-test driver only. This file is deliberately non-executable and does
# not implement the later maven-sorting mutation harness.
# 2. Maven command keeps executable before arguments

set -euo pipefail
export LC_ALL=C LANG=C GOENV=off GOWORK=off

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
go_bin=${GO:-go}

cd "$repo_root"
"$go_bin" test -json ./pkg/maven -count=1 \
	-run '^(TestMavenCommandKeepsExecutableBeforeArguments|TestMavenProcessDependenciesDefaultToNoProcess|TestRecordedMavenCommandsRejectEmptyPopulation)$'
