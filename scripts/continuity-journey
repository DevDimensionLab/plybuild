#!/usr/bin/env python3
"""Prepare an isolated installed-Ply journey through provider upgrade and cleanup."""

import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["prepare"])
    parser.add_argument("--ply", default=shutil.which("ply"),
                        help="installed candidate executable (default: ply on PATH)")
    parser.add_argument("--root", type=Path,
                        help="new disposable directory; defaults to a private temporary directory")
    args = parser.parse_args()
    if not args.ply:
        parser.error("install the candidate first or pass --ply /absolute/installed/ply")
    binary = Path(args.ply).resolve(strict=True)
    if not binary.is_file() or not os.access(binary, os.X_OK):
        parser.error("--ply must name an executable installed candidate")
    repo = Path(__file__).resolve().parent.parent
    for revision, override in (
        ("f2de0c638f1d2b1c38417aff70b79ca7bb4be31a", "PLY_CONTINUITY_OLD_BINARY"),
        ("6472bb87e11de6512adcde65c03b1be41ce46646", "PLY_CONTINUITY_BEFORE_UPGRADE_BINARY"),
    ):
        if os.environ.get(override):
            continue
        found = subprocess.run(["git", "cat-file", "-e", revision + "^{commit}"],
                               cwd=repo, capture_output=True)
        if found.returncode:
            parser.error("historical source " + revision + " is required locally; "
                         "use a full checkout or " + override + " built from that revision")
    if args.root is None:
        root = Path(tempfile.mkdtemp(prefix="ply-continuity-journey.")).resolve()
    else:
        root = args.root.expanduser().absolute()
        root.mkdir(mode=0o700, parents=True, exist_ok=False)
        root = root.resolve(strict=True)
    root.chmod(0o700)
    workspace = root / "workspace"
    builder = root / "taskrun.test"
    print("Building the native isolated fixture harness…", flush=True)
    subprocess.run(["go", "test", "-c", "-o", str(builder), "./internal/taskrun"],
                   cwd=repo, check=True)
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", PLY_DELIVERY_TEST_BINARY=str(binary),
               PLY_CONTINUITY_JOURNEY_ROOT=str(workspace))
    print("Starting the historical delivery, publishing unrelated newer metadata, "
          "preserving the correction's successful check and failed qualification, "
          "then replacing the synthetic provider installation…", flush=True)
    result = subprocess.run([str(builder), "-test.run=^TestContinuityCLIExportHumanJourney$",
                             "-test.v", "-test.timeout=5m"],
                            cwd=repo / "internal/taskrun", env=env,
                            capture_output=True, text=True)
    (root / "preparation.log").write_text(result.stdout + result.stderr)
    if result.returncode:
        print(result.stdout + result.stderr)
        raise SystemExit(f"Fixture preparation failed; evidence retained at {root}")
    journey = workspace / "journey"
    shutil.copyfile(repo / "test/continuity_journey.py", journey)
    journey.chmod(0o700)
    print("\nThe earlier candidate qualified. The corrected acceptance exited 0; "
          "the historical reader failed qualification after the unrelated publication.")
    print("Its original synthetic provider launcher is now removed, and ordinary provider "
          "lookup resolves a distinct synthetic installation.")
    print("The pre-fix continuation and original report callback both failed; actual "
          "exits and outputs are preserved in the fixture.")
    print("The provider, runtime authority and earlier QA are explicitly synthetic fixtures.")
    print("No live Task, provider, notification route or global setting was changed.")
    print(f"\nRun these in the same terminal:\n  {journey} inspect\n  {journey} report-incomplete\n  {journey} continue\n"
          f"  {journey} verify\n  {journey} inspect")
    print("\nTo exercise the disposable delivery's separate human gate, inspect it first, then:")
    print(f"  {journey} qa pass\n  {journey} integrate\n  {journey} inspect")
    print("Your acceptance of the implementation is a separate answer to its delivery owner.")


if __name__ == "__main__":
    main()
