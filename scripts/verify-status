#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C LANG=C GOENV=off GOWORK=off
unset CDPATH

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "$repo_root/test/acceptance/common.sh"
tmp_base=${TMPDIR:-/tmp}
tmp_base=${tmp_base%/}
work_root=$(mktemp -d "$tmp_base/ply-verify-status.XXXXXX")
cleanup_work_root() {
	acceptance_stop_server
	find "$work_root" -type d -exec chmod u+rwx {} + 2>/dev/null || true
	rm -rf -- "$work_root"
}
trap cleanup_work_root EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
log="$work_root/verdict.log"
artifact=${PLY_VERIFY_ARTIFACT:-"$work_root/bin/ply"}
failures=0
guard_message='A help probe alone proves nothing without read-only status behavior.'
printf '%s\n' "$guard_message" | tee -a "$log" >/dev/null

if [[ -z "${PLY_VERIFY_ARTIFACT:-}" ]]; then
	acceptance_build_artifact "$repo_root" "$work_root" "$artifact"
fi
[[ -f "$artifact" && -x "$artifact" ]] || failures=$((failures + 1))

if "$artifact" status --help >"$work_root/help.stdout" 2>"$work_root/help.stderr" &&
	grep -F 'Status functionality for a project' "$work_root/help.stdout" >/dev/null; then
	printf 'status --help: PASS\n' | tee -a "$log"
else
	printf 'status --help: FAIL\n' | tee -a "$log"
	failures=$((failures + 1))
fi

acceptance_start_server "$repo_root" "$work_root" '99.0.0'
acceptance_prepare_home "$work_root/home" "$ACCEPTANCE_SERVER_URL"
acceptance_copy_order_fixture "$repo_root" "$work_root/project"
before_digest=$(acceptance_tree_digest "$work_root/project")
if HOME="$work_root/home" "$artifact" status \
	--target "$work_root/project" --cloud-sync=false 2>&1 |
	tee -a "$log" >"$work_root/status.stdout"; then
	status_exit=0
else
	status_exit=${PIPESTATUS[0]}
fi
after_digest=$(acceptance_tree_digest "$work_root/project")
printf 'status exit=%s\n' "$status_exit" | tee -a "$log"
if [[ "$status_exit" -ne 0 || "$before_digest" != "$after_digest" ]] ||
	! grep -F 'project status in' "$work_root/status.stdout" >/dev/null ||
	! grep -F 'outdated' "$work_root/status.stdout" >/dev/null; then
	failures=$((failures + 1))
fi

mkdir -p "$work_root/bad-project/src"
bad_before=$(acceptance_tree_digest "$work_root/bad-project")
set +e
HOME="$work_root/home" "$artifact" status \
	--target "$work_root/bad-project" --cloud-sync=false 2>&1 |
	tee -a "$log" >"$work_root/bad.stdout"
bad_exit=${PIPESTATUS[0]}
set -e
bad_after=$(acceptance_tree_digest "$work_root/bad-project")
if [[ "$bad_exit" -eq 0 || "$bad_before" != "$bad_after" ]]; then
	failures=$((failures + 1))
fi

[ "$failures" -eq 0 ]
printf 'verify-status: PASS\n'
