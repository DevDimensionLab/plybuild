#!/usr/bin/env bash
# P3 seam-test driver only. This file is deliberately non-executable and does
# not implement the later template mutation harness.
# 6. template copy keeps source before destination

set -euo pipefail
export LC_ALL=C LANG=C GOENV=off GOWORK=off

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
go_bin=${GO:-go}

cd "$repo_root"
"$go_bin" test -json ./internal/adapter/filesystem ./pkg/file ./pkg/template -count=1 \
	-run '^(TestDependenciesDefaultToSafeNoFilesystemMutation|TestOperationsPassCompleteValuesToDependency|TestOperationsReturnDependencyErrors|TestSystemPerformsCompleteFilesystemOperations|TestCopyOrMergeMissingTargetSelectsCopyWithCompleteDependency|TestCopyOrMergeExistingTargetRetainsMergeSelection|TestCopyFileReturnsDependencyErrorsInLegacyOrder|TestCopyDependenciesDefaultToNoMutation|TestRecordedCopyOperationsRejectEmptyPopulation|TestCopyFilePreservesSourceBytesModeAndCreatesDestinationDirectory|TestTemplateCopyKeepsCompleteSourceBeforeCompleteResolvedDestination|TestTemplateCopyReturnsDependencyErrorAfterCompleteDelivery|TestTemplateCopyDependenciesDefaultToNoMutation|TestRecordedTemplateCopyCallsRejectEmptyPopulation)$'
