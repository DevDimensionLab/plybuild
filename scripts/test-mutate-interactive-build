#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C LANG=C GOENV=off GOWORK=off

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
harness="$repo_root/scripts/mutate-interactive-build"
tmp_base=${TMPDIR:-/tmp}
tmp_base=${tmp_base%/}
work_root=$(mktemp -d "$tmp_base/ply-test-mutate-interactive-build.XXXXXX")
cleanup() {
	find "$work_root" -type d -exec chmod u+rwx {} + 2>/dev/null || true
	rm -rf "$work_root"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
	printf 'test-mutate-interactive-build: %s\n' "$*" >&2
	exit 1
}

[[ -f $harness && ! -L $harness && -x $harness ]] ||
	fail 'production harness must be a regular executable file'
[[ $(grep -cE '^mutate "' "$harness") -eq 10 ]] ||
	fail 'production harness must declare exactly ten visible mutations'
[[ $(grep -Fxc '# 8. interactive server binds only to loopback' "$harness") -eq 1 ]] ||
	fail 'loopback-server mutation label is missing or duplicated'
[[ $(grep -Fxc '[ "$survived" -eq 0 ] || fail '\''surviving mutations remain'\''' "$harness") -eq 1 ]] ||
	fail 'production harness zero-survivor gate is missing or duplicated'

run_failure() {
	local name=$1 expected=$2
	local output="$work_root/$name.log"
	shift 2
	if MUTATION_INTERACTIVE_BUILD_META_TEST=1 "$@" "$harness" >"$output" 2>&1; then
		fail "$name falsification unexpectedly passed"
	fi
	grep -F "$expected" "$output" >/dev/null || {
		sed -n '1,160p' "$output" >&2
		fail "$name falsification did not report its exact contract"
	}
}

printf 'T1 manifest must be non-empty and unique\n'
run_failure T1-empty 'T1 mutation manifest is empty' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=empty-manifest
run_failure T1-duplicate 'T1 duplicate mutation ID' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=duplicate-manifest

printf 'T2 mutations must stay inside authorized production roots\n'
run_failure T2 'T2 mutation path is outside cmd/build.go and pkg/webservice' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=out-of-scope

printf 'T3 every source replacement must apply exactly once\n'
run_failure T3-zero 'T3 mutation source replacement count is 0, want exactly 1' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=zero-replacement
run_failure T3-multiple 'want exactly 1' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=multiple-replacement

printf 'T4 every mutant must select a non-empty exact test population\n'
run_failure T4 'T4 selected test population is empty or inexact' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=empty-selection

printf 'T5 the clean unmodified control must pass\n'
run_failure T5 'T5 clean unmodified control failed' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=broken-control

printf 'T6 a mutant must compile and execute its selected tests\n'
run_failure T6 'T6 mutant was not compiled and exercised' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=unexercised

printf 'T7 reported result accounting must match immutable result records\n'
run_failure T7 'T7 falsified result accounting' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=false-accounting

printf 'T8 every survivor needs a gap classification\n'
run_failure T8 'T8 surviving mutation lacks reachability, observability, or controllability classification' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=survivor-unclassified

printf 'T9 every checkout cache report and artifact must be external\n'
run_failure T9 'repository-local artifacts are forbidden' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=repository-local-artifacts
[[ ! -e $repo_root/.mutation-local-artifacts-meta ]] ||
	fail 'T9 repository-local artifact probe created its rejected path'

printf 'T10 declared mutations and totals must be deterministic\n'
run_failure T10 'T10 mutation manifest or declared totals are non-deterministic' \
	env MUTATION_INTERACTIVE_BUILD_META_FAULT=nondeterministic

positive_log="$work_root/positive.log"
"$harness" >"$positive_log"
grep -Fxc 'subject=interactive-build' "$positive_log" >/dev/null || fail 'positive report lost its subject'
grep -Fxc 'control=passed selections=10' "$positive_log" >/dev/null || fail 'positive report lost its clean control count'
grep -Fxc 'declared=10 killed=10 survived=0 unusable=0' "$positive_log" >/dev/null ||
	fail 'positive report totals are not exact'

expected_mutations=(
	'interactive-build-project-config-wiring|TestInteractiveBuildPreservesRootOptionsEndpointCallbackAndValidationOrder'
	'interactive-build-cloud-config-wiring|TestInteractiveBuildPreservesRootOptionsEndpointCallbackAndValidationOrder'
	'interactive-build-root-response-wiring|TestInteractiveBuildPreservesRootOptionsEndpointCallbackAndValidationOrder'
	'interactive-build-generate-endpoint|TestInteractiveBuildPreservesRootOptionsEndpointCallbackAndValidationOrder'
	'interactive-build-uri-host|TestInteractiveWebserviceCallersPreserveEndpointServerBrowserAndCallbackComposition'
	'interactive-build-server-start-mode|TestInteractiveWebserviceCallersPreserveEndpointServerBrowserAndCallbackComposition'
	'interactive-build-loopback-bind|TestInteractiveWebServerBindsOnlyToExactIPv4Loopback'
	'interactive-build-generate-api-route|TestStartWebServerRegistersExactHandlersBeforeOneListenAndLogsOnlyNonNilError'
	'interactive-build-listen-error-gate|TestStartWebServerRegistersExactHandlersBeforeOneListenAndLogsOnlyNonNilError'
	'interactive-build-darwin-platform-selection|TestBrowserLauncherPreservesEveryPlatformRequestURLStartAttemptAndError'
)
[[ ${#expected_mutations[@]} -eq 10 ]] || fail 'expected mutation population is empty or incomplete'
for expected in "${expected_mutations[@]}"; do
	id=${expected%%|*}
	tests=${expected#*|}
	grep -E "^mutation=${id} status=killed .* tests=${tests} detail=selected-test-failure$" \
		"$positive_log" >/dev/null || fail "positive report did not bind killed mutation $id to $tests"
done

printf 'test-mutate-interactive-build: PASS (T1-T10, declared=10 killed=10 survived=0 unusable=0)\n'
