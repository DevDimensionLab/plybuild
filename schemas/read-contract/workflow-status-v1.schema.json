          "type": "array",
          "items": {
            "$ref": "#/$defs/workflow_action"
          },
          "description": "Sorted by current=true first, severity (attention before next_step), then oldest known since_utc (null last). Remaining keys compare lexically: source, kind, actor, run_id, queue_id, reason. Null run_id and queue_id sort as empty strings."
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
