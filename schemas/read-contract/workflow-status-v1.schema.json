        },
        "queues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/queue"
          },
          "description": "Sorted by queue_id, then state. Rank has meaning only within its Project/Repo/Epic queue."
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "title_status": {
                "const": "available"
