          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true,
      "description": "Historical executable path and digest from the preserved recovery record. Status does not inspect these binaries, attest the current runtime, or grant permission to execute them."
    },
