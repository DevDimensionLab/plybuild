{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ply:read-contract:workspace-project-readback-v1",
  "title": "WorkspaceProjectReadback@1",
  "description": "Public CLI response contract. Every named field is required; unknown additive fields are allowed.",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "workspace",
    "scope",
    "project",
    "repositories"
  ],
  "properties": {
    "kind": {
      "const": "WorkspaceProjectReadback@1",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "scope": {
      "type": "object",
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "workspace": {
      "type": "object",
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "description": "Physical absolute workspace root from the validated workspace marker."
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "name",
        "wrapper",
        "repo_count"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "wrapper": {
          "type": "string",
          "description": "Registered absolute wrapper path; no existence or freshness claim."
        },
        "repo_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "repository": {
      "type": "object",
      "required": [
        "repo_id",
        "locator",
        "git_common_dir"
      ],
      "properties": {
        "repo_id": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "Registered absolute repository locator; checkout may be absent."
        },
        "git_common_dir": {
          "type": "string",
          "description": "Registered absolute Git common directory; no new Git observation."
        }
      },
      "additionalProperties": true
    }
  }
}
