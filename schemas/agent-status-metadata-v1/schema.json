{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AgentStatusMetadataReadback@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "observed_at_utc",
    "sources",
    "agents"
  ],
  "properties": {
    "kind": {
      "const": "AgentStatusMetadataReadback@1"
    },
    "schema_version": {
      "const": 1
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "status",
          "freshness",
          "source_observed_at_utc",
          "coverage",
          "scope"
        ],
        "properties": {
          "source": {
            "const": "herdr.agent.list"
          },
          "status": {
            "enum": [
              "available",
              "empty",
              "partial",
              "unavailable"
            ]
          },
          "freshness": {
            "enum": [
              "fresh",
              "unknown"
            ]
          },
          "source_observed_at_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "coverage": {
            "enum": [
              "complete",
              "partial",
              "unknown"
            ]
          },
          "scope": {
            "const": "Recognized codex/claude agents in the current Herdr user agent list; maximum 4096 source rows."
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pane",
          "provider",
          "status",
          "tab",
          "workspace"
        ],
        "properties": {
          "pane": {
            "type": "string",
            "maxLength": 256,
            "description": "At most 256 UTF-16 code units; no controls, paths or surrounding whitespace.",
            "minLength": 1
          },
          "provider": {
            "enum": [
              "codex",
              "claude"
            ]
          },
          "status": {
            "enum": [
              "working",
              "idle",
              "done",
              "blocked",
              "unknown"
            ]
          },
          "tab": {
            "type": "string",
            "maxLength": 256,
            "description": "At most 256 UTF-16 code units; no controls, paths or surrounding whitespace."
          },
          "workspace": {
            "type": "string",
            "maxLength": 256,
            "description": "At most 256 UTF-16 code units; no controls, paths or surrounding whitespace."
          }
        }
      }
    }
  }
}
