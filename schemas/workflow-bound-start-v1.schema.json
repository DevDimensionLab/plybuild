{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ply:workflow:bound-start:1",
  "title": "Ply bound Goal start v1",
  "oneOf": [{"$ref":"#/$defs/request"},{"$ref":"#/$defs/preview"},{"$ref":"#/$defs/status"}],
  "$defs": {
    "digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "requestId": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "error": {"type":"object","required":["code","detail"],"properties":{"code":{"type":"string","pattern":"^bound_start_"},"detail":{"type":"string"}},"additionalProperties":true},
    "request": {
      "type":"object","additionalProperties":false,
      "required":["kind","schema_version","request_id","workspace","input"],
      "properties": {
        "kind":{"const":"ply.workflow.bound-start-request"},"schema_version":{"const":1},
        "request_id":{"$ref":"#/$defs/requestId"},"workspace":{"type":"string","pattern":"^/"},"binding":{"type":"string","description":"Informational historical preview checksum; not a startup prerequisite or request identity selector."},
        "input": {
          "type":"object","additionalProperties":false,"required":["spec_id","target","start_mode","herdr_workspace","permission_profile"],
          "properties": {
            "spec_id":{"type":"string","minLength":1},"start_mode":{"const":"interactive"},"herdr_workspace":{"type":"string","minLength":1,"maxLength":128},"permission_profile":{"type":"string"},
            "target":{"type":"object","additionalProperties":false,"required":["project_id","repo_id","epic_id"],"properties":{"project_id":{"type":"string"},"repo_id":{"type":"string"},"epic_id":{"type":"string"}}}
          }
        }
      }
    },
    "preview": {
      "type":"object","required":["kind","schema_version","state","request","basis"],"additionalProperties":true,
      "properties":{"kind":{"const":"ply.workflow.bound-start-preview"},"schema_version":{"const":1},"state":{"enum":["ready","rejected"]},"request":{"type":"object"},"basis":{"type":"object"},"error":{"$ref":"#/$defs/error"}},
      "allOf":[{"if":{"properties":{"state":{"const":"ready"}}},"then":{"properties":{"request":{"$ref":"#/$defs/request"},"basis":{"type":"object","required":["goal","runtime","environment","policy_sources","permission_definition","registry_sha256","project_sha256","trust","runtime_acceptance","effects"]}}}}]
    },
    "status": {
      "type":"object","required":["kind","schema_version","request_id","workspace","state","execution_effect","next_action"],"additionalProperties":true,
      "properties":{"kind":{"const":"ply.workflow.bound-start-status"},"schema_version":{"const":1},"request_id":{"type":"string"},"workspace":{"type":"string"},"state":{"enum":["not_recorded","retained_attempt","existing_run","outcome_unknown","rejected"]},"execution_effect":{"enum":["not_confirmed","none","reserved","unknown"]},"binding":{"type":"string","description":"Informational historical preview checksum; not a startup prerequisite or request identity selector."},"expected_run_id":{"type":"string","pattern":"^wfr_[0-9a-f]{64}$"},"run":{"type":"object","required":["run_id","state","freshness","unresolved"]},"next_action":{"type":"string"},"error":{"$ref":"#/$defs/error"}}
    }
  }
}
