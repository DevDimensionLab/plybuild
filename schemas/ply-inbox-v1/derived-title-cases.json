{
  "kind": "InboxDerivedTitleCases@1",
  "rule": "derived-title-v1",
  "fallback_title": "Svar uten tekst",
  "max_code_points": 60,
  "cases": [
    {
      "name": "empty body",
      "body": "",
      "derived_title": "Svar uten tekst"
    },
    {
      "name": "only blank and marker lines",
      "body": "\n   \n#\n- \n> \n1.\n",
      "derived_title": "Svar uten tekst"
    },
    {
      "name": "heading",
      "body": "## Spec ferdig",
      "derived_title": "Spec ferdig"
    },
    {
      "name": "nested markers",
      "body": "> - **Spec** `ferdig`",
      "derived_title": "Spec ferdig"
    },
    {
      "name": "numbered list",
      "body": "12. Første punkt",
      "derived_title": "Første punkt"
    },
    {
      "name": "plus and star",
      "body": "+ * Punkt",
      "derived_title": "Punkt"
    },
    {
      "name": "marker without whitespace is text",
      "body": "#tag og >pil",
      "derived_title": "#tag og >pil"
    },
    {
      "name": "bold start is not a list marker",
      "body": "**Viktig:** les",
      "derived_title": "Viktig: les"
    },
    {
      "name": "leading blank lines",
      "body": "\n\n   \n  Tekst  her\nNeste",
      "derived_title": "Tekst her"
    },
    {
      "name": "crlf line endings",
      "body": "\r\n# Tittel\r\nmer",
