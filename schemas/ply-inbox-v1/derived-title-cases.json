    },
    {
      "name": "collapse whitespace",
      "body": "a \t  b",
      "derived_title": "a b"
    },
    {
      "name": "exactly 60 code points",
      "body": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "derived_title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    {
      "name": "61 code points without space",
      "body": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "derived_title": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb…"
    },
    {
      "name": "61 code points with space",
      "body": "ord ccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
